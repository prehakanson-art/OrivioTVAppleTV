+// MARK: - TEMPORARY hold-Select diagnostics (DEBUG only — remove when done)
+//
+// Logs, to Documents/holdDiag.log on the device:
+//   • every Select press reaching the window (down / up / cancelled, with the
+//     hold duration and the UIKit view hierarchy above the focused view),
+//   • every focus change (so a presented context menu shows up as focus
+//     moving onto a menu item, or doesn't),
+//   • every SwiftUI body evaluation of the card / row / screen views, so a
+//     re-render landing inside the hold window is visible with a timestamp.
+#if DEBUG
+import UIKit.UIGestureRecognizerSubclass
+
+@MainActor
+enum HoldDiag {
+    static let fileURL: URL = FileManager.default
+        .urls(for: .documentDirectory, in: .userDomainMask)[0]
+        .appendingPathComponent("holdDiag.log")
+    private static let start = Date()
+    private static var installed = false
+    private static var focusObserver: NSObjectProtocol?
+    private static var pressLogger: HoldDiagPressLogger?
+
+    static func log(_ message: String) {
+        let t = String(format: "%9.3f", Date().timeIntervalSince(start))
+        let line = "\(t)  \(message)\n"
+        NSLog("[HoldDiag] %@", message)
+        guard let data = line.data(using: .utf8) else { return }
+        if let handle = try? FileHandle(forWritingTo: fileURL) {
+            handle.seekToEndOfFile()
+            handle.write(data)
+            try? handle.close()
+        } else {
+            try? data.write(to: fileURL)
+        }
+    }
+
+    /// Call once from the root view; retries until a key window exists.
+    static func install() {
+        guard !installed else { return }
+        installed = true
+        try? FileManager.default.removeItem(at: fileURL)
+        log("=== HoldDiag session start; \(UIDevice.current.systemName) \(UIDevice.current.systemVersion) ===")
+        Task { @MainActor in
+            for _ in 0..<40 {
+                if let window = keyWindow() {
+                    attach(to: window)
+                    return
+                }
+                try? await Task.sleep(nanoseconds: 250_000_000)
+            }
+            log("!! no key window found; press logging NOT installed")
+        }
+    }
+
+    private static func keyWindow() -> UIWindow? {
+        UIApplication.shared.connectedScenes
+            .compactMap { $0 as? UIWindowScene }
+            .flatMap(\.windows)
+            .first { $0.isKeyWindow } ??
+        UIApplication.shared.connectedScenes
+            .compactMap { $0 as? UIWindowScene }
+            .flatMap(\.windows).first
+    }
+
+    private static func attach(to window: UIWindow) {
+        let logger = HoldDiagPressLogger()
+        window.addGestureRecognizer(logger)
+        pressLogger = logger
+        focusObserver = NotificationCenter.default.addObserver(
+            forName: UIFocusSystem.didUpdateNotification, object: nil, queue: .main
+        ) { note in
+            let ctx = note.userInfo?[UIFocusSystem.focusUpdateContextUserInfoKey] as? UIFocusUpdateContext
+            let next = ctx?.nextFocusedItem
+            let prev = ctx?.previouslyFocusedItem
+            let msg = "FOCUS -> \(describe(next))   (from \(describe(prev)))"
+            MainActor.assumeIsolated { log(msg) }
+        }
+        log("press logger + focus observer installed on \(type(of: window))")
+    }
+
+    static func describe(_ item: UIFocusItem?) -> String {
+        guard let item else { return "nil" }
+        guard let view = item as? UIView else { return String(describing: type(of: item)) }
+        var names: [String] = []
+        var v: UIView? = view
+        var depth = 0
+        while let cur = v, depth < 7 {
+            var name = String(describing: type(of: cur))
+            if let id = cur.accessibilityIdentifier, !id.isEmpty { name += "#\(id)" }
+            if let label = cur.accessibilityLabel, !label.isEmpty { name += "(\(label.prefix(24)))" }
+            names.append(name)
+            v = cur.superview
+            depth += 1
+        }
+        return names.joined(separator: " < ")
+    }
+
+    static func focusedItem() -> UIFocusItem? {
+        guard let window = keyWindow() else { return nil }
+        return UIFocusSystem.focusSystem(for: window)?.focusedItem
+    }
+}
+
+/// Never recognises; only observes press timing on the window so nothing
+/// about the app's own press handling changes.
+final class HoldDiagPressLogger: UIGestureRecognizer, UIGestureRecognizerDelegate {
+    private var downAt: [Int: Date] = [:]
+
+    init() {
+        super.init(target: nil, action: nil)
+        cancelsTouchesInView = false
+        delaysTouchesBegan = false
+        delaysTouchesEnded = false
+        allowedTouchTypes = []
+        allowedPressTypes = [NSNumber(value: UIPress.PressType.select.rawValue),
+                             NSNumber(value: UIPress.PressType.playPause.rawValue),
+                             NSNumber(value: UIPress.PressType.menu.rawValue)]
+        delegate = self
+    }
+
+    private func name(_ p: UIPress) -> String {
+        switch p.type {
+        case .select: return "select"
+        case .playPause: return "playPause"
+        case .menu: return "menu"
+        default: return "other(\(p.type.rawValue))"
+        }
+    }
+
+    override func pressesBegan(_ presses: Set<UIPress>, with event: UIPressesEvent) {
+        for p in presses {
+            downAt[p.type.rawValue] = Date()
+            let focused = MainActor.assumeIsolated { HoldDiag.describe(HoldDiag.focusedItem()) }
+            let responder = p.responder.map { String(describing: type(of: $0)) } ?? "nil"
+            MainActor.assumeIsolated {
+                HoldDiag.log("PRESS DOWN \(name(p)); responder=\(responder); focused=\(focused)")
+            }
+        }
+    }
+
+    override func pressesChanged(_ presses: Set<UIPress>, with event: UIPressesEvent) {}
+
+    override func pressesEnded(_ presses: Set<UIPress>, with event: UIPressesEvent) {
+        for p in presses {
+            let held = downAt[p.type.rawValue].map { Date().timeIntervalSince($0) } ?? -1
+            MainActor.assumeIsolated {
+                HoldDiag.log("PRESS UP   \(name(p)); held=\(String(format: "%.3f", held))s")
+            }
+        }
+        state = .failed
+    }
+
+    override func pressesCancelled(_ presses: Set<UIPress>, with event: UIPressesEvent) {
+        for p in presses {
+            let held = downAt[p.type.rawValue].map { Date().timeIntervalSince($0) } ?? -1
+            MainActor.assumeIsolated {
+                HoldDiag.log("PRESS CANCELLED \(name(p)); held=\(String(format: "%.3f", held))s")
+            }
+        }
+        state = .failed
+    }
+
+    override func reset() {
+        super.reset()
+        downAt.removeAll()
+    }
+
+    func gestureRecognizer(_ g: UIGestureRecognizer,
+                           shouldRecognizeSimultaneouslyWith other: UIGestureRecognizer) -> Bool { true }
+    func gestureRecognizer(_ g: UIGestureRecognizer,
+                           shouldBeRequiredToFailBy other: UIGestureRecognizer) -> Bool { false }
+    func gestureRecognizer(_ g: UIGestureRecognizer,
+                           shouldRequireFailureOf other: UIGestureRecognizer) -> Bool { false }
+}
+#endif
